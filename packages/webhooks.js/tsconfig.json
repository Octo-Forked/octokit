{
  "extends": "@octokit/tsconfig",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "declaration": true,
    "outDir": "pkg/dist-types",
    "emitDeclarationOnly": true,
    "sourceMap": true,
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
